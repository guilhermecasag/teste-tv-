# Banco de dados PostgreSQL
DATABASE_URL="postgresql://usuario:senha@localhost:5432/ltm_automacao?schema=public"

# Autenticacao (Auth.js / NextAuth v5)
# Gere um valor com: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Locais proximos (restaurante, farmacia, lavanderia, mercado, posto):
# usa OpenStreetMap (Nominatim + Overpass), que nao exige chave.
# Deixe este campo vazio - existe apenas para o caso de, no futuro,
# trocar para Google Places.
GOOGLE_MAPS_API_KEY=""

# Clima: usa Open-Meteo (gratuito, sem chave). Deixe vazio.
WEATHER_API_KEY=""

# Notificacoes Web Push (VAPID). Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@suaempresa.com"

# Armazenamento de fotos (opcional). Sem estas variaveis, o sistema usa
# disco local em /public/uploads (funcional, mas nao recomendado para producao).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ltm-fotos"
