generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MONTADOR
  ESPECTADOR
}

enum TripStatus {
  PLANEJADA
  EM_DESLOCAMENTO
  EM_MONTAGEM
  PAUSADA
  CONCLUIDA
  CANCELADA
}

enum ProgressMethod {
  IGUAL
  PONDERADO
}

enum EquipmentStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  BLOQUEADO
}

enum PhotoCategory {
  INICIO
  ANDAMENTO
  CONCLUIDO
  PROBLEMA
  GERAL
}

enum IssueStatus {
  ABERTA
  RESOLVIDA
}

enum TimelineEventType {
  VIAGEM_STATUS
  EQUIPAMENTO_STATUS
  EQUIPAMENTO_OBSERVACAO
  EQUIPAMENTO_FOTO
  PENDENCIA_ABERTA
  PENDENCIA_RESOLVIDA
}

/// Secao 20 do briefing.
enum NotificationType {
  NOVA_VIAGEM
  ALTERACAO
  VOO
  MONTAGEM
  PROBLEMA
  PROGRESSO
  MENSAGEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(MONTADOR)
  phone        String?
  whatsapp     String?
  cargo        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tripMemberships      TripUser[]
  responsibleFor       Equipment[]
  createdClients       Client[]         @relation("ClientCreatedBy")
  espectadorTrips      TripViewer[]
  uploadedPhotos       EquipmentPhoto[]
  reportedIssues       EquipmentIssue[]
  timelineEvents       TimelineEvent[]
  notifications        Notification[]
  pushSubscriptions     PushSubscription[]

  @@map("users")
}

model Client {
  id           String   @id @default(cuid())
  name         String
  cnpj         String?
  contactName  String?
  phone        String?
  whatsapp     String?
  address      String?
  city         String?
  state        String?
  notes        String?
  createdById  String?
  createdBy    User?    @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trips Trip[]

  @@map("clients")
}

model Trip {
  id             String         @id @default(cuid())
  clientId       String
  client         Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  address        String?
  city           String
  state          String
  /// Geocodificadas sob demanda (Nominatim) a partir de address/city/state - secao 9/10.
  latitude       Float?
  longitude      Float?
  startDate      DateTime
  endDate        DateTime
  status         TripStatus     @default(PLANEJADA)
  progressMethod ProgressMethod @default(IGUAL)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  travelInfo TripTravelInfo?
  members    TripUser[]
  viewers    TripViewer[]
  equipment  Equipment[]
  timeline   TimelineEvent[]

  @@map("trips")
}

/// Informacoes de deslocamento e hospedagem da viagem (secoes 8/9/30 do briefing).
model TripTravelInfo {
  id     String @id @default(cuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  flightInfo    String?
  transportInfo String?
  driverName    String?
  driverPhone   String?

  hotelName      String?
  hotelAddress   String?
  hotelPhone     String?
  hotelCheckIn   DateTime?
  hotelCheckOut  DateTime?
  /// Geocodificadas sob demanda a partir de hotelAddress - secao 9.
  hotelLatitude  Float?
  hotelLongitude Float?

  notes String?

  @@map("trip_travel_info")
}

/// Montadores alocados na viagem.
model TripUser {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@map("trip_users")
}

/// Espectadores/gestores autorizados a acompanhar a viagem.
model TripViewer {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tripId, userId])
  @@map("trip_viewers")
}

model Equipment {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  name        String
  code        String?
  description String?
  /// Observacao atual do montador sobre o andamento (secao 13 do briefing).
  observation String?
  status      EquipmentStatus @default(PENDENTE)
  /// Peso usado quando trip.progressMethod = PONDERADO. Ignorado em IGUAL.
  weight      Float           @default(1)

  responsibleId String?
  responsible   User?   @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos EquipmentPhoto[]
  issues EquipmentIssue[]
  timeline TimelineEvent[]

  @@map("equipment")
}

model EquipmentPhoto {
  id          String        @id @default(cuid())
  equipmentId String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  url         String
  category    PhotoCategory @default(GERAL)

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@map("equipment_photos")
}

model EquipmentIssue {
  id          String @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  description String
  status      IssueStatus @default(ABERTA)

  responsibleId String?
  responsible   User?   @relation(fields: [responsibleId], references: [id], onDelete: SetNull)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@map("equipment_issues")
}

/// Feed cronologico da viagem (secoes 19 e 34 do briefing).
model TimelineEvent {
  id     String @id @default(cuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  type    TimelineEventType
  message String

  createdAt DateTime @default(now())

  @@map("timeline_events")
}

/// Cache da previsao do tempo (Open-Meteo) por coordenada, para nao
/// bater na API a cada carregamento de tela - secao 10 do briefing.
model WeatherCache {
  id          String   @id @default(cuid())
  locationKey String   @unique
  latitude    Float
  longitude   Float
  payload     Json
  fetchedAt   DateTime @default(now())

  @@map("weather_cache")
}

/// Central de notificacoes (sino no topo) - secoes 20-22 do briefing.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tripId String?

  type    NotificationType
  title   String
  message String
  read    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notifications")
}

/// Inscricoes Web Push (VAPID) por usuario/dispositivo - secao 39 do briefing.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}
